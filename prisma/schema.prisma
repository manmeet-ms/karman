generator client {
  provider   = "prisma-client"
  output     = "../generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

// Enums
enum ViolationTypeEnum {
  MISSED_BLOCK
  MISSED_RITUAL
  FAILED_TIMER
}

enum TxnType {
  TIMEBLOCK_COMPLETE_CREDIT
  ALL_DAILY_COMPLETE_CREDIT
  VIOLATION_RESOLVED_CREDIT
  NEW_STREAK_CREDIT
  EXTEND_STREAK_CREDIT
  DIARY_WRITING_CREDIT
  RITUAL_COMPLETE_CREDIT
  URGE_LOGGED_CREDIT
  URGE_RESISTED_CREDIT
  MOOD_LOGGED_CREDIT
  MOOD_IMPROVEMENT_CREDIT
  RITUAL_MISS_PENALTY
  URGE_FAILURE_PENALTY
  BLOCK_MISS_PENALTY
  STREAK_BREAK_PENALTY
  VIOLATION_PENALTY
  TIMER_RESET_PENALTY
  PUNISHMENT_TRIGGER_PENALTY
  DEFAULT
}

enum MoodTypeEnum {
  HAPPY
  ANXIOUS
  ANGRY
  STRESSED
  SAD
  NEUTRAL
  EXCITED
}

enum UrgeTypeEnum {
  PROCRASTINATION
  DISTRACTION
  DOOMSCROLL
  BROWSING
  ADDICTION
  OTHER
}

enum UrgeTriggerEnum {
  BOREDOM
  STRESS
  ANXIETY
  HABITUAL_TIME
  SOCIAL_MEDIA_NOTIFICATION
  BEING_ALONE
  SEEING_OTHERS_ONLINE
  AVOIDING_HARD_TASK
  TIREDNESS
  MINDLESS_ROUTINE
  DOPAMINE_CRAVING
  OVERWHELMED
  NO_CLEAR_GOAL
  PEER_INFLUENCE
  SEEKING_COMFORT
}

enum UrgeLocationEnum {
  BEDROOM
  WORKSPACE
  LIBRARY
  COLLEGE
  COMMUTE
  LIVING_ROOM
  ALONE
  IN_PUBLIC
}

// User & Auth
model Account {
  id                 String    @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?   @db.Text
  access_token       String?   @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?   @db.Text
  session_state      String?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  expires      DateTime
  sessionToken String   @unique
  accessToken  String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                 String          @id @default(cuid())
  username           String?         @unique // Made optional for OAuth compatibility initially, can be enforced later
  name               String?
  email              String?         @unique
  password           String?         // Optional because of OAuth
  role               String          @default("user")
  points             Int             @default(0)
  image              String?
  emailVerified      DateTime?
  isVerified         Boolean         @default(false)
  verificationToken  String?
  passwordResetToken String?
  passwordResetTokenExpiry DateTime?
  streak             Int             @default(0)

  accounts           Account[]
  sessions           Session[]

  // Activities
  timeBlocks         TimeBlock[]
  rituals            Ritual[]
  timers             Timer[]
  hourlyCheckins     HourlyCheckin[]
  violations         Violation[]
  pointsTxns         PointsTxn[]
  moodTrackers       MoodTracker[]
  urges              Urge[]
  diaryEntries       Diary[]
  agreementItems     AgreementItem[]
  longtermModules    LongtermModule[]
  people             Person[]
  reminders          Reminder[]
  advice             Advice[]
  pushSubscriptions  PushSubscription[]
  globalPosts        GlobalPost[]
  
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

// Activities

model TimeBlock {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  task        String
  description String?
  startTime   String
  endTime     String
  date        String
  strict      Boolean  @default(true)
  completed   Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, date])
}

model Ritual {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  date                  String
  vow                   String
  completedDailyCheckIn Boolean  @default(false)
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId, date])
}

model Timer {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  codename             String
  title                String
  description          String?
  failures             Int      @default(0)
  timerStarted         String
  perks                Json?
  punishments          Json?
  alternates           Json?
  quoteFlashingAllowed Boolean? @default(false)
  pulseTheme           String?

  createdAt            DateTime @default(now()) // Added for consistency
  updatedAt            DateTime @updatedAt      // Added for consistency

  @@index([userId])
}

model HourlyCheckin {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  note      String   @default("def: No Activity Shared") @db.Text
  tag       String   @default("def: No activity")
  entryDate String?
  context   String?
  mood      Mood?    // Relation to embedded Mood

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, entryDate])
}

model Violation {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  type           ViolationTypeEnum
  timestamp      DateTime          @default(now())
  resolved       Boolean           @default(false)
  tauntStatement String?
  blockData      Json?
  reason         String?
  dateString     String?           // For indexing by date

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([userId, dateString])
}

model PointsTxn {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type         TxnType
  points       Int
  balanceAfter Int
  metadata     Json?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model MoodTracker {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  moodType      MoodTypeEnum
  intensity     Int          @default(6)
  notes         String?      @db.Text
  tags          String[]
  trigger       String?
  location      String?
  physicalState String?
  date          String?      // Added for indexing consistency with prompt

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([userId, date])
}

model Urge {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  urgeTimeStamp DateTime          @default(now())
  urgeIntensity Int               @default(6)
  urgeType      UrgeTypeEnum      @default(OTHER)
  urgeTrigger   UrgeTriggerEnum?
  urgeLocation  UrgeLocationEnum?
  urgeResolved  Boolean           @default(false)
  urgeNotes     String?           @db.Text
  date          String?           // Added for indexing consistency

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([userId, date])
}

// Side Models (Not directly user activities, or managed differently)

model Mood {
  id              String        @id @default(cuid())
  hourlyCheckin   HourlyCheckin @relation(fields: [hourlyCheckinId], references: [id], onDelete: Cascade)
  hourlyCheckinId String        @unique

  moodType      MoodTypeEnum
  intensity     Int      @default(1)
  notes         String?  @db.Text
  tags          String[]
  trigger       String?
  location      String?
  physicalState String?
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  keys      Json?
  createdAt DateTime @default(now())

  @@index([userId])
}

model PhilosopherQuote {
  id          String   @id @default(cuid())
  philosopher Json
  quotes      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LoggedQuote {
   id          String   @id @default(cuid())
   quoteId     String
   philosopher String
   quote       String   @db.Text
   createdAt   DateTime @default(now())
   updatedAt   DateTime @updatedAt
}

enum AgreementCategory {
  AGREEMENT
  WARNINGS
  UNDERSTANDING
  MANAGING
}

model AgreementItem {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  AgreementCategory
  content   String            @db.Text
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([userId, category])
}

model Diary {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title     String?
  content   String   @db.Text
  tags      String[]
  date      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model LongtermModule {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String?
  content     String?  @db.Text
  startDate   String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Person {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  relation  String?
  notes     String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Reminder {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String?  @db.Text
  time        String?
  type        String
  interval    Int
  enabled     Boolean  @default(true)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum AdviceTag {
  CORPORATE
  PERSONAL
  PSYCHOLOGICAL
  MANIPULATIVE
  OTHER
}

model Advice {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  content   String      @db.Text
  tags      AdviceTag[]
  
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
}

enum GlobalPostType {
  QUOTE
  TECHNIQUE
  ACHIEVEMENT
  ADVICE
}

model GlobalPost {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      GlobalPostType
  content   String         @db.Text
  likes     Int            @default(0)
  
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([userId, type])
}

